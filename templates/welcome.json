                "type": "text",
                "values": {
                  "containerPadding": "8px 36px",
                  "anchor": "",
                  "fontSize": "15px",
                  "color": "#374151",
                  "textAlign": "left",
                  "lineHeight": "165%",
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#0000ee",
                    "linkHoverColor": "#0000ee",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "hideDesktop": false,
                  "displayCondition": null,
                  "_styleGuide": null,
                  "_meta": {
                    "htmlID": "u_content_text_5",
                    "htmlClassNames": "u_content_text"
                  },
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "locked": false,
                  "text": "<p style=\"margin: 0 0 16px 0;\">Thank you for taking the time to apply for the <strong>Google Developer Groups on Campus (GDG AJCE) Core Team</strong>{{team_suffix}}. We truly appreciate your enthusiasm and passion for contributing to our tech community.</p><p style=\"margin: 0 0 16px 0;\">We received an overwhelming number of applications from talented students across various departments. Because we have strictly limited spots available for each domain, the selection process was exceptionally challenging, and we regret to inform you that we are unable to offer you a core team role for this term.</p><p style=\"margin: 0;\">Please know that this was a difficult decision driven solely by domain quotas and team capacity, and is in no way a reflection of your dedication, skills, or potential.</p>"
                }
              },
              {
                "id": "u_content_p2",
                "type": "text",
                "values": {
                  "containerPadding": "8px 36px 16px 36px",
                  "anchor": "",
                  "fontSize": "15px",
                  "color": "#374151",
                  "textAlign": "left",
                  "lineHeight": "165%",
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#0000ee",
                    "linkHoverColor": "#0000ee",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "hideDesktop": false,
                  "displayCondition": null,
                  "_styleGuide": null,
                  "_meta": {
                    "htmlID": "u_content_text_7",
                    "htmlClassNames": "u_content_text"
                  },
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "locked": false,
                  "text": "<p style=\"margin: 0 0 16px 0;\">We strongly encourage you to participate in our upcoming events, join our technical sessions, and connect with fellow developers. We will also have upcoming calls for event volunteers and organizing contributors where your skills will be highly valued.</p><p style=\"margin: 0;\">Thank you once again for your support and interest in GDG AJCE. We look forward to learning and building together with you!</p>"
                }
              }
