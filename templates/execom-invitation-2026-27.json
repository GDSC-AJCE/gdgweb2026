0\" border=\"0\"><tr><td style=\"padding: 0px;background-color: #f1f5f9;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#ffffff\"><tr style=\"background-color: #ffffff;\"><![endif]-->\n      \n<!--[if (mso)|(IE)]><td align=\"center\" width=\"600\" style=\"background-color: #ffffff;width: 600px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\" valign=\"top\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;\"><![endif]-->\n<div class=\"u-col u-col-100\" style=\"max-width: 320px;min-width: 600px;display: table-cell;vertical-align: top;\">\n  <div style=\"background-color: #ffffff;height: 100%;width: 100% !important;\">\n  <!--[if (!mso)&(!IE)]><!--><div style=\"box-sizing: border-box; height: 100%; padding: 0px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\"><!--<![endif]-->\n  \n<table id=\"u_content_image_3\" style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:0px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tr>\n    <td style=\"padding-right: 0px;padding-left: 0px;\" align=\"center\">\n      \n      <!--[if mso]><img align=\"center\" border=\"0\" src=\"https://assets.unlayer.com/projects/0/1793981389866-GDG%20Header.png?w=1160px\" alt=\"GDG Header\" title=\"GDG Header\" style=\"outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;clear: both;display: inline-block !important;border: none;float: none;\" width=\"600\" height=\"149\" class=\"v-src-width v-src-max-width\"/><![endif]--><!--[if !mso]><!--><img align=\"center\" border=\"0\" src=\"https://assets.unlayer.com/projects/0/1793981389866-GDG%20Header.png?w=1160px\" alt=\"GDG Header\" title=\"GDG Header\" style=\"outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;clear: both;display: inline-block !important;border: none;height: auto;float: none;width: 100%;max-width: 600px;\" width=\"600\" class=\"v-src-width v-src-max-width\"/><!--<![endif]-->\n      \n    </td>\n  </tr>\n</table>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!--[if (!mso)&(!IE)]><!--></div><!--<![endif]-->\n  </div>\n</div>\n<!--[if (mso)|(IE)]></td></tr></table></td><![endif]-->\n      <!--[if (mso)|(IE)]></tr></table></td></tr></table><![endif]-->\n    </div>\n  </div>\n</div>\n\n\n\n\n\n<div class=\"u-row-container\" style=\"padding: 0px;background-color: #f1f5f9;\">\n  <div class=\"u-row\" style=\"margin: 0 auto;min-width: 320px;max-width: 600px;overflow-wrap: break-word;word-wrap: break-word;word-break: break-word;background-color: #ffffff;\">\n    <div style=\"border-collapse: collapse;display: table;width: 100%;height: 100%;background-color: transparent;\">\n      <!--[if (mso)|(IE)]><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;background-color: #f1f5f9;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#ffffff\"><tr style=\"background-color: #ffffff;\"><![endif]-->\n      \n<!--[if (mso)|(IE)]><td align=\"center\" width=\"600\" style=\"background-color: #ffffff;width: 600px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\" valign=\"top\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;\"><![endif]-->\n<div class=\"u-col u-col-100\" style=\"max-width: 320px;min-width: 600px;display: table-cell;vertical-align: top;\">\n  <div style=\"background-color: #ffffff;height: 100%;width: 100% !important;\">\n  <!--[if (!mso)&(!IE)]><!--><div style=\"box-sizing: border-box; height: 100%; padding: 0px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\"><!--<![endif]-->\n  \n<table style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:14px 36px 12px 36px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n  <!--[if mso]><table role=\"presentation\" width=\"100%\"><tr><td><![endif]-->\n    <h1 style=\"margin: 0px; color: #0f172a; line-height: 130%; text-align: left; word-wrap: break-word; font-size: 24px; font-weight: 400;\"><span>Congratulations, New GDG AJCE Excecom 2026-27 Members!</span></h1>\n  <!--[if mso]></td></tr></table><![endif]-->\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<table style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:6px 36px 16px 36px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n  <div style=\"font-size: 15px; color: #334155; line-height: 165%; text-align: left; word-wrap: break-word;\">\n    <p style=\"margin:0 0 12px;\">Dear <strong>{{name}}</strong>,</p>\n    <p style=\"margin:0 0 12px;\">Welcome to the GDG AJCE Executive Committee! Your dedication and passion for fostering a vibrant developer community stood out, and we're thrilled to have you in the '{{team}}' role.</p>\n    <p style=\"margin:0 0 12px;\">As an Excecom member, you'll play a pivotal role in organizing impactful events and initiatives, collaborating with peers, and gaining invaluable leadership and technical experience.</p>\n    <p style=\"margin:0;\">Please join our official GDG AJCE Excecom WhatsApp group immediately for essential updates, planning, and coordination. We look forward to your active participation!</p>\n  </div>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<table style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:6px 36px 26px 36px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n  <div>\n    <div style=\"text-align:center;\"><a href=\"{{whatsapp_link}}\" target=\"_blank\" style=\"box-sizing:border-box; display:inline-block; text-decoration:none; background-color:#25D366; color:#ffffff; border-radius:28px; padding:13px 24px; font-size:14px; font-weight:700; margin:6px; box-shadow:0 4px 12px rgba(37,211,102,0.35); text-align:center; border:1px solid #1ebe5d;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"display:inline-table; vertical-align:middle;\"><tr><td style=\"vertical-align:middle; padding-right:10px;\"><img src=\"https://gdgajce.vercel.app/assets/whatsapp-icon.png\" width=\"22\" height=\"22\" alt=\"WhatsApp\" style=\"display:block; width:22px; height:22px; border:0;\" /></td><td style=\"vertical-align:middle; color:#ffffff; font-size:14px; font-weight:700; line-height:1;\">Join Execom WhatsApp Group</td></tr></table></a></div>\n  </div>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<table style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:0px 36px 18px 36px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n  <div style=\"font-size: 13px; color: #64748b; line-height: 170%; text-align: left; word-wrap: break-word;\">\n    <div style=\"border-top:1px solid #f1f5f9; padding-top:18px;\"><strong style=\"color:#334155; font-size:13px;\">Your First Steps as an Excecom Member:</strong><ul style=\"margin:8px 0 0 18px; padding:0;\"><li style=\"line-height:22px;\">Join the official GDG AJCE Excecom WhatsApp group immediately for critical updates and discussions.</li><li style=\"line-height:22px;\">Familiarize yourself with the GDG mission, vision, and past events on our official website.</li><li style=\"line-height:22px;\">Look out for the invitation to our first Excecom onboarding meeting, which will be shared soon.</li><li style=\"line-height:22px;\">Prepare to actively contribute your ideas and energy to our upcoming initiatives.</li><li style=\"line-height:22px;\">Connect with fellow Excecom members and core team leads within the WhatsApp group.</li></ul></div>\n  </div>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!--[if (!mso)&(!IE)]><!--></div><!--<![endif]-->\n  </div>\n</div>\n<!--[if (mso)|(IE)]></td></tr></table></td><![endif]-->\n      <!--[if (mso)|(IE)]></tr></table></td></tr></table><![endif]-->\n    </div>\n  </div>\n</div>\n\n\n\n\n\n<div class=\"u-row-container\" style=\"padding: 0px;background-color: #f1f5f9;\">\n  <div class=\"u-row\" style=\"margin: 0 auto;min-width: 320px;max-width: 600px;overflow-wrap: break-word;word-wrap: break-word;word-break: break-word;background-color: #ffffff;\">\n    <div style=\"border-collapse: collapse;display: table;width: 100%;height: 100%;background-color: transparent;\">\n      <!--[if (mso)|(IE)]><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;background-color: #f1f5f9;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" bgcolor=\"#ffffff\"><tr style=\"background-color: #ffffff;\"><![endif]-->\n      \n<!--[if (mso)|(IE)]><td align=\"center\" width=\"600\" style=\"background-color: #ffffff;width: 600px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\" valign=\"top\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;\"><![endif]-->\n<div class=\"u-col u-col-100\" style=\"max-width: 320px;min-width: 600px;display: table-cell;vertical-align: top;\">\n  <div style=\"background-color: #ffffff;height: 100%;width: 100% !important;\">\n  <!--[if (!mso)&(!IE)]><!--><div style=\"box-sizing: border-box; height: 100%; padding: 0px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\"><!--<![endif]-->\n  \n<table id=\"u_content_image_4\" style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:0px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n        \n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n  <tr>\n    <td style=\"padding-right: 0px;padding-left: 0px;\" align=\"center\">\n      <a href=\"https://gdgajce.vercel.app/\" target=\"_blank\">\n      <!--[if mso]><img align=\"center\" border=\"0\" src=\"https://assets.unlayer.com/projects/0/1793981396347-GDG%20Footer.jpg?w=1160px\" alt=\"GDG Footer\" title=\"GDG Footer\" style=\"outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;clear: both;display: inline-block !important;border: none;float: none;\" width=\"600\" height=\"161\" class=\"v-src-width v-src-max-width\"/><![endif]--><!--[if !mso]><!--><img align=\"center\" border=\"0\" src=\"https://assets.unlayer.com/projects/0/1793981396347-GDG%20Footer.jpg?w=1160px\" alt=\"GDG Footer\" title=\"GDG Footer\" style=\"outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;clear: both;display: inline-block !important;border: none;height: auto;float: none;width: 100%;max-width: 600px;\" width=\"600\" class=\"v-src-width v-src-max-width\"/><!--<![endif]-->\n      </a>\n    </td>\n  </tr>\n</table>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!--[if (!mso)&(!IE)]><!--></div><!--<![endif]-->\n  </div>\n</div>\n<!--[if (mso)|(IE)]></td></tr></table></td><![endif]-->\n      <!--[if (mso)|(IE)]></tr></table></td></tr></table><![endif]-->\n    </div>\n  </div>\n</div>\n\n\n\n    <!--[if (mso)|(IE)]></td></tr></table></td></tr></table><![endif]-->\n    </td>\n  </tr>\n  </tbody>\n  </table>\n  <!--[if mso]></div><![endif]-->\n  <!--[if IE]></div><![endif]-->\n</body>\n\n</html>\n",
