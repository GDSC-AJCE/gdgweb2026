<mjml>
  <mj-head>
    <mj-title>Welcome to the GDG AJCE Core Team!</mj-title>
    <mj-font name="Google Sans" href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Google Sans', Roboto, Arial, sans-serif" color="#374151" />
      <mj-text font-size="15px" line-height="1.65" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <!-- Main Card -->
    <mj-section background-color="#ffffff" padding="32px 36px 24px 36px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#1f2937" padding="0 0 16px 0">
          Congratulations & Welcome, {{name}}! 🎉
        </mj-text>

        <mj-text padding="0 0 16px 0">
          We are thrilled to officially welcome you to the <strong>Google Developer Groups on Campus (GDG AJCE) Core Team</strong>{{team_suffix}}!
        </mj-text>

        <!-- Celebration Box -->
        <mj-section background-color="#ecfdf5" border-left="4px solid #10b981" border-radius="6px" padding="16px">
          <mj-column padding="0">
            <mj-text font-weight="700" color="#065f46" font-size="15px" padding="0 0 4px 0">
              🚀 You are shaping the future of tech at AJCE
            </mj-text>
            <mj-text font-size="14px" color="#047857" padding="0">
              Your application and skills stood out among hundreds of candidates. Together, we will organize world-class bootcamps, hackathons, and Google Cloud study jams.
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-text padding="20px 0 16px 0">
          <strong>Next Steps:</strong>
          <ul>
            <li>Join our official Core Team Discord / WhatsApp channel.</li>
            <li>Attend the Core Team Orientation Sync (details to follow).</li>
          </ul>
        </mj-text>

        <mj-button background-color="#1a73e8" color="#ffffff" font-weight="700" border-radius="8px" href="https://gdg.community.dev/gdg-ajce/">
          Join Core Team Workspace
        </mj-button>

        <mj-divider border-color="#e5e7eb" border-width="1px" padding="20px 0" />

        <mj-text padding="0" line-height="1.6">
          Best regards,<br>
          <strong>GDG AJCE Core Team</strong><br>
          <span style="font-size: 13px; color: #6b7280;">Google Developer Groups on Campus · AJCE</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Social Links -->
    <mj-section padding="16px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af" padding="0">
          Stay connected: 
          <a href="https://gdg.community.dev/gdg-ajce/" style="color: #1a73e8; text-decoration: underline;">Community Page</a> · 
          <a href="https://www.linkedin.com/company/gdg-ajce/" style="color: #1a73e8; text-decoration: underline;">LinkedIn</a> · 
          <a href="https://instagram.com/gdg_ajce" style="color: #1a73e8; text-decoration: underline;">Instagram</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>