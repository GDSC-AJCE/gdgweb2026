                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "locked": false,
                  "text": "<p style=\"margin:0 0 12px;\">Dear <strong>{{name}}</strong>,</p><p style=\"margin:0 0 12px;\">We are excited to share that after reviewing your application, you have been <strong>officially shortlisted</strong> for the next round of interviews for the <strong>Google Developer Groups on Campus (GDG AJCE) Core Team</strong>{{team_suffix}}!</p><p style=\"margin:0;\">We were thoroughly impressed by your enthusiasm, background, and vision for our tech community. This next round will be a focused interaction to discuss your ideas, interests, and how you can make a meaningful impact with GDG AJCE.</p>"
                }
