                  "html": "<div style=\"text-align:center;\"><a href=\"{{whatsapp_link}}\" target=\"_blank\" style=\"box-sizing:border-box; display:inline-block; text-decoration:none; background-color:#25D366; color:#ffffff; border-radius:28px; padding:13px 24px; font-size:14px; font-weight:700; margin:6px; box-shadow:0 4px 12px rgba(37,211,102,0.35); text-align:center; border:1px solid #1ebe5d;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"display:inline-table; vertical-align:middle;\"><tr><td style=\"vertical-align:middle; padding-right:10px;\"><img src=\"/assets/whatsapp-icon.png\" width=\"22\" height=\"22\" alt=\"WhatsApp\" style=\"display:block; width:22px; height:22px; border:0;\" /></td><td style=\"vertical-align:middle; color:#ffffff; font-size:14px; font-weight:700; line-height:1;\">Join WhatsApp Group</td></tr></table></a><a href=\"{{meet_link}}\" target=\"_blank\" style=\"box-sizing:border-box; display:inline-block; text-decoration:none; background-color:#FF6C61; color:#ffffff; border-radius:28px; padding:13px 24px; font-size:14px; font-weight:700; margin:6px; box-shadow:0 4px 14px rgba(11,87,208,0.35); text-align:center; border:1px solid #FF4738;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"display:inline-table; vertical-align:middle;\"><tr><td style=\"vertical-align:middle; padding-right:10px;\"><img src=\"/assets/google-meet-icon.png\" width=\"22\" height=\"22\" alt=\"Google Meet\" style=\"display:block; width:22px; height:22px; border:0;\" /></td><td style=\"vertical-align:middle; color:#ffffff; font-size:14px; font-weight:700; line-height:1;\">Join Google Meet</td></tr></table></a></div>",
