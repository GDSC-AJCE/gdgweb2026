                "id": "u_content_schedule_box",
                "type": "html",
                "values": {
                  "html": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f8fafc; border:1px solid #cbd5e1; border-radius:12px; overflow:hidden;\"><tr><td style=\"padding:18px 20px;\"><div style=\"font-size:12px; font-weight:800; color:#1e293b; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:12px; border-bottom:1px solid #e2e8f0; padding-bottom:8px;\">GDG EXECOM SELECTION &bull; Assigned Slot Details</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:5px 0; font-size:14px; color:#475569; width:130px; font-weight:600;\">Category:</td><td style=\"padding:5px 0; font-size:14px; color:#0f172a; font-weight:700;\">{{category}}</td></tr><tr><td style=\"padding:5px 0; font-size:14px; color:#475569; width:130px; font-weight:600;\">Date:</td><td style=\"padding:5px 0; font-size:14px; color:#0f172a; font-weight:700;\">{{date}}</td></tr><tr><td style=\"padding:5px 0; font-size:14px; color:#475569; width:130px; font-weight:600;\">Time:</td><td style=\"padding:5px 0; font-size:14px; color:#0b57d0; font-weight:700;\">{{time}}</td></tr><tr><td style=\"padding:5px 0; font-size:14px; color:#475569; width:130px; font-weight:600;\">Time Zone:</td><td style=\"padding:5px 0; font-size:14px; color:#0f172a; font-weight:600;\">Asia/Kolkata (IST)</td></tr><tr><td style=\"padding:5px 0; font-size:14px; color:#475569; width:130px; font-weight:600;\">Platform:</td><td style=\"padding:5px 0; font-size:14px; color:#0f172a; font-weight:600;\">Google Meet (Video Call)</td></tr></table></td></tr></table>",
