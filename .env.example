# Site URL
NEXT_PUBLIC_SITE_URL=https://gdgajce.vercel.app

# Firebase Client Configuration for Google Developer Groups (GDG)
# Add these in Vercel Project Settings > Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Chapter Information
NEXT_PUBLIC_GDG_CHAPTER_NAME="GDG on Campus AJCE"
NEXT_PUBLIC_GDG_LOCATION="Amal Jyothi College of Engineering"

# AI Newsletter Generation (Optional / Server-side)
GEMINI_API_KEY=your_gemini_api_key

# Cron Secret for automated dispatch (Optional)
CRON_SECRET=gdg_cron_weekly_secret

# SMTP Email Configuration (Optional - can also be configured dynamically in Admin settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="GDG Tech Pulse <your_email@gmail.com>"
SMTP_SECURE=false
