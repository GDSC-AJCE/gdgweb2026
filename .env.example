# Site URL
NEXT_PUBLIC_SITE_URL=https://gdgajce.vercel.app

# Firebase Client Configuration for Google Developer Groups (GDG)
# Add these in Vercel Project Settings > Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Chapter Information
NEXT_PUBLIC_GDG_CHAPTER_NAME="GDG on Campus AJCE"
NEXT_PUBLIC_GDG_LOCATION="Amal Jyothi College of Engineering"

# AI Newsletter Generation (Optional / Server-side Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Cron Secret for automated newsletter dispatch (Optional)
CRON_SECRET=gdg_cron_weekly_secret

# Resend Email Configuration (Recommended - https://resend.com)
# Uses emailmd for markdown-to-HTML rendering
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="GDG AJCE <onboarding@resend.dev>"

# Legacy SMTP Configuration (Fallback if Resend is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="GDG Tech Pulse <your_email@gmail.com>"
SMTP_SECURE=false

# Mail Studio & Dispatch Engine Keys (Google Apps Script Gateway & OAuth)
CLIENT_ID=your_google_client_id
CLIENT_SECRET=your_google_client_secret
REDIRECT_URI=https://developers.google.com/oauthplayground
REFRESH_TOKEN=your_google_refresh_token
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Not Shortlisted
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
SENDER_NAME=GDG on Campus AJCE
GMAIL_USER=dsc@amaljyothi.ac.in
APPS_SCRIPT_GATEWAY_URL=https://script.google.com/macros/s/AKfycbxcIThvSrqiIT-4lKcJA-Z5EjGfwWtbXWMpljIL4ebMhfaNWX-OD2nJ_9qDosCcwq7O/exec
APPS_SCRIPT_API_KEY=gdgajce

NEXT_PUBLIC_GOOGLE_SHEET_ID=your_google_sheet_id
NEXT_PUBLIC_GOOGLE_SHEET_NAME=Not Shortlisted
NEXT_PUBLIC_SENDER_NAME="GDG on Campus AJCE"
NEXT_PUBLIC_SENDER_EMAIL=dsc@amaljyothi.ac.in
NEXT_PUBLIC_APPS_SCRIPT_GATEWAY_URL=https://script.google.com/macros/s/AKfycbxcIThvSrqiIT-4lKcJA-Z5EjGfwWtbXWMpljIL4ebMhfaNWX-OD2nJ_9qDosCcwq7O/exec
NEXT_PUBLIC_APPS_SCRIPT_API_KEY=gdgajce

