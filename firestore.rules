rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user document has is_admin: true or email is an authorized chapter lead
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'dsc@amaljyothi.ac.in',
          'vinayakprakash2026@cs.ajce.in',
          'abinvarghese092005@gmail.com',
          'abinvarghese2026@cs.ajce.in',
          'karthiksambhu123@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_admin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    // Check if the user is a core team member OR an admin (readers)
    function isCoreUser() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['core', 'core-manage', 'admin']
        ))
      );
    }

    // Check if the user is a core manager, core organizer, OR an admin (writers)
    function isCoreWriter() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['core', 'core-manage', 'admin']
        ))
      );
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // 1. USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isCoreUser();
      allow create: if isOwner(userId) || isCoreWriter();
      allow update: if isOwner(userId) || isCoreWriter();
      allow delete: if isCoreWriter();

      // User's own issued certificates subcollection
      match /certificates/{certId} {
        allow read: if isOwner(userId) || isCoreUser();
        allow write: if isCoreWriter() || isOwner(userId);
      }
    }

    // ============================================
    // 2. ROOT CERTIFICATES (Universal /verify/[id] lookup)
    // ============================================
    match /certificates/{certificateId} {
      // Anyone on the internet can read & verify a certificate
      allow read: if true;
      // Core members and admins can create/update/revoke certificates
      allow create, update, delete: if isCoreWriter();
    }

    // ============================================
    // 3. EVENTS & SUBCOLLECTIONS
    // ============================================
    match /events/{eventId} {
      // Public event directory
      allow read: if true;
      allow create, update, delete: if isCoreWriter();

      // Participants / Attendees subcollection
      match /participants/{participantId} {
        allow read: if isCoreUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isCoreUser();
        allow update, delete: if isCoreUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }

      // Certificate Templates subcollection
      match /certificates/{certificateId} {
        allow read: if true;
        allow write: if isCoreWriter();
      }

      // Issued Certificates subcollection
      match /issuedCertificates/{issuedCertId} {
        allow read: if true;
        allow write: if isCoreWriter();
      }
    }

    // ============================================
    // 4. CORE PROFILES (Team & Execom)
    // ============================================
    match /coreProfiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isCoreWriter() || (isAuthenticated() && request.auth.uid == profileId);
    }

    // ============================================
    // 5. EXECOM APPLICATIONS & RECRUITMENT
    // ============================================
    match /execomApplications/{applicationId} {
      allow read: if isCoreUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Allows student submissions
      allow update, delete: if isCoreWriter() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /membershipApplications/{applicationId} {
      allow read: if isCoreUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isCoreWriter();
    }

    // ============================================
    // 6. SITE SETTINGS & CONFIGS
    // ============================================
    match /settings/{settingId} {
      // Allow reading homepage, recruitment status, or by core users
      allow read: if true;
      allow write: if isCoreWriter();
    }

    // ============================================
    // 7. PUBLIC GALLERY & MEMORIES
    // ============================================
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isCoreWriter();
    }

    // ============================================
    // 8. LEADERBOARD & RANKINGS
    // ============================================
    match /leaderboard/{studentId} {
      allow read: if true;
      allow write: if isCoreWriter();
    }

    // ============================================
    // 9. AUDIT LOGS & TELEMETRY
    // ============================================
    match /auditLogs/{logId} {
      allow read: if isCoreUser();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ============================================
    // 10. CONTACT FORM INBOX
    // ============================================
    match /contactFormResponses/{responseId} {
      allow read: if isCoreUser();
      allow create: if true; // Public submission
      allow update, delete: if isCoreWriter();
    }

    // ============================================
    // 11. CHAPTER FUNDS & TREASURY
    // ============================================
    match /funds/{fundId} {
      allow read: if isCoreUser();
      allow write: if isCoreWriter();
    }

    // ============================================
    // 12. NEWSLETTER SUBSCRIBERS & CAMPAIGNS
    // ============================================
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isCoreUser();
      allow create: if true;
      allow update, delete: if isCoreWriter();
    }

    match /newsletters/{newsletterId} {
      allow read: if true;
      allow write: if isCoreWriter();
    }

    // ============================================
    // 13. TRASH RECYCLE BIN
    // ============================================
    match /bin/{binId} {
      allow read, write: if isCoreWriter();
    }

    // ============================================
    // 14. COLLECTION GROUP QUERIES
    // ============================================
    match /{path=**}/issuedCertificates/{issuedCertId} {
      allow read: if true;
    }

    match /{path=**}/certificates/{certId} {
      allow read: if true;
    }

    match /{path=**}/participants/{participantId} {
      allow read: if isCoreUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ============================================
    // 15. MAIL TEMPLATES
    // ============================================
    match /mail_templates/{templateId} {
      allow read: if true;
      allow write: if isAuthenticated() || isCoreWriter();
    }
  }
}
